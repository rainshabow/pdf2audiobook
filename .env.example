# ===== LLM（opencode dsv4-flash，OpenAI 兼容）=====
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4-flash

# ===== TTS 引擎 =====
# 可选：mock（开发测试） | qwen_webui（本机 qwen-tts-webui） | edge_tts（免费备选）
TTS_ENGINE=mock
TTS_API_URL=http://127.0.0.1:7860
QWEN_TTS_DIR=D:\WorkSpace\qwen-tts-webui
QWEN_PYTHON=python
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_SPEAKER=
TTS_SPEED=1.25
TTS_INSTRUCT=用平稳、一致的叙述语气朗读，情绪保持中性稳定，前后句语气连贯。

# ===== 服务 =====
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATA_DIR=data
